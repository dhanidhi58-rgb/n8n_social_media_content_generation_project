    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst message = String(\n  data.message?.text ?? data.text ?? \"\"\n).trim();\n\n// Format: SCHEDULE 105-1 | 2026-10-20 18:30\nconst match = message.match(\n  /^SCHEDULE\\s+(\\d+-\\d+)\\s*\\|\\s*(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{2}:\\d{2})$/i\n);\n\nif (!match) {\n  throw new Error(\n    \"Invalid format. Use: SCHEDULE 105-1 | 2026-10-20 18:30\"\n  );\n}\n\nconst chat_id =\n  data.message?.chat?.id ??\n  data.chat?.id ??\n  data.chat_id;\n\nif (chat_id === undefined || chat_id === null) {\n  throw new Error(\"Chat ID nahi mili.\");\n}\n\nconst contentId = match[1];\nconst dateStr = match[2]; // 2026-10-20\nconst timeStr = match[3]; // 18:30\n\n// Google Calendar ke liye ISO Start Time\nconst startTime = `${dateStr}T${timeStr}:00`;\n\n// 1 ghante ka duration set karne ke liye End Time\nconst startDate = new Date(`${dateStr}T${timeStr}:00`);\nstartDate.setHours(startDate.getHours() + 1);\nconst hours = String(startDate.getHours()).padStart(2, '0');\nconst minutes = String(startDate.getMinutes()).padStart(2, '0');\nconst endTime = `${dateStr}T${hours}:${minutes}:00`;\n\nreturn [\n  {\n    json: {\n      Content_ID: contentId,\n      Scheduled_Date: `${dateStr} ${timeStr}`,\n      summary: `Content ID: ${contentId} Schedule`,\n      description: `Scheduled via Telegram bot for content ID ${contentId}`,\n      start_time: startTime,\n      end_time: endTime,\n      chat_id: chat_id\n    }\n  }\n];"
      },

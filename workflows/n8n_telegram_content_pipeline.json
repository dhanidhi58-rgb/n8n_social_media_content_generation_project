      "parameters": {
        "jsCode": "// Safely input data get karein\nconst inputItem = $input.first()?.json || {};\n\n// Text extract karein\nconst message = String(\n  inputItem.message?.text ??\n  inputItem.body?.message?.text ??\n  inputItem.text ??\n  inputItem.body?.text ??\n  inputItem.Content_ID ??\n  inputItem.content_id ??\n  \"\"\n).trim();\n\n// Chat ID extract karein\nconst chat_id =\n  inputItem.message?.chat?.id ??\n  inputItem.body?.message?.chat?.id ??\n  inputItem.chat?.id ??\n  inputItem.body?.chat?.id ??\n  inputItem.chat_id ??\n  null;\n\n// Extract Content ID (e.g. 105-1)\nlet contentId = \"\";\nconst match = message.match(/^REJECT\\s+(\\d+-\\d+)$/i);\n\nif (match) {\n  contentId = match[1];\n} else {\n  const idMatch = message.match(/(\\d+-\\d+)/);\n  contentId = idMatch ? idMatch[1] : message;\n}\n\nif (!contentId) {\n  throw new Error(\"Content ID nahi mil pa rahi hai.\");\n}\n\nreturn [\n  {\n    json: {\n      Content_ID: contentId,\n      Approval_Status: \"Rejected\",\n      Approved_At: \" \",      // Single space -> Sheet ka purana time permanently erase kar dega\n      Scheduled_Date: \" \",   // Single space -> Sheet ki purani date permanently erase kar dega\n      chat_id: chat_id\n    }\n  }\n];"
      },
